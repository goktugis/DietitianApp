@{
    ViewData["Title"] = "Danışan Panelim";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold text-dark mb-1">Merhaba, @User.Identity?.Name! 👋</h2>
        <p class="text-muted fs-5">Sağlık yolculuğunuzda bugün neler yapıyoruz?</p>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- İstatistik Kartları -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-primary text-white">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold mb-3"><i class="bi bi-calendar-event me-2"></i> Yaklaşan Randevular</h5>
                    <h2 class="display-3 fw-bold mb-0">@(((IEnumerable<DietitianApp.Models.Appointment>)ViewBag.UpcomingAppointments).Count())</h2>
                </div>
                <div class="mt-4">
                    <a asp-controller="Clients" asp-action="Index" class="btn btn-light btn-sm rounded-pill px-3 fw-bold text-primary">Yeni Randevu Al</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Hızlı İşlemler Kartları -->
    <div class="col-md-4">
        <a href="/DietLists" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-hover-effect">
                <div class="card-body p-4 text-center d-flex flex-column align-items-center justify-content-center">
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle mb-3">
                        <i class="bi bi-list-check text-success fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Diyet Listelerim</h5>
                    <p class="text-muted small mb-0">Diyetisyeninizin hazırladığı atamaları görüntüleyin.</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a href="/MealLogs" class="text-decoration-none">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-hover-effect">
                <div class="card-body p-4 text-center d-flex flex-column align-items-center justify-content-center">
                    <div class="bg-info bg-opacity-10 p-3 rounded-circle mb-3">
                        <i class="bi bi-egg-fried text-info fs-1"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Öğün Takibi</h5>
                    <p class="text-muted small mb-0">Bugün neler yediğinizi kaydedin ve fotoğraf ekleyin.</p>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row">
    <!-- Yaklaşan Randevular Listesi -->
    <div class="col-lg-8 mb-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-2">
                <h5 class="fw-bold text-dark mb-0">Yaklaşan Görüntüşmeleriniz</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small">
                            <tr>
                                <th class="ps-4">Tarih</th>
                                <th>Saat</th>
                                <th>Diyetisyen</th>
                                <th>Durum</th>
                                <th class="pe-4 text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!((IEnumerable<DietitianApp.Models.Appointment>)ViewBag.UpcomingAppointments).Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Planlanmış yakın tarihli bir randevunuz bulunmuyor.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var appt in (IEnumerable<DietitianApp.Models.Appointment>)ViewBag.UpcomingAppointments)
                                {
                                    <tr>
                                        <td class="ps-4 fw-medium">@appt.AppointmentDate.ToString("dd MMM yyyy")</td>
                                        <td>@appt.StartTime.ToString(@"hh\:mm")</td>
                                        <td>@appt.Dietitian?.Name @appt.Dietitian?.Surname</td>
                                        <td><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Onaylandı</span></td>
                                        <td class="pe-4 text-end">
                                            <a href="/Chat?userId=@appt.DietitianId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                <i class="bi bi-chat-dots me-1"></i> Mesajlaş
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ Yan Hızlı Bildirimler ve Grafikler -->
    <div class="col-lg-4">
        <!-- Yemek Takip Grafiği -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4 pb-0">
                 <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-fill text-primary me-2"></i> Haftalık Öğün Takibi</h5>
            </div>
            <div class="card-body p-4">
                 <canvas id="mealChart" height="200"></canvas>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 water-tracker-card overflow-hidden">
             <div class="card-body p-4 text-center position-relative">
                 <div class="position-relative z-3">
                     <div class="d-flex justify-content-between align-items-center mb-3">
                         <h5 class="fw-bold text-dark mb-0"><i class="bi bi-droplet-fill text-info me-1"></i> Su Takibi</h5>
                         <button class="btn btn-sm btn-link text-muted p-0 text-decoration-none" id="editGoalBtn" title="Hedefi Değiştir">
                             <i class="bi bi-gear-fill"></i>
                         </button>
                     </div>

                     <!-- Goal Update Inline Form (Hidden by default) -->
                     <div id="goalEditForm" class="d-none mb-3 p-3 bg-white bg-opacity-75 rounded-3 border">
                         <label class="form-label small fw-bold text-muted">Günlük Su Hedefi (ml)</label>
                         <div class="input-group input-group-sm">
                             <input type="number" id="newGoalInput" class="form-control rounded-start-pill" min="500" max="10000" step="250" value="@ViewBag.WaterGoal" />
                             <button class="btn btn-primary rounded-end-pill px-3" id="saveGoalBtn">Kaydet</button>
                         </div>
                         <div id="goalError" class="text-danger small mt-1 d-none"></div>
                     </div>

                     <!-- Circular Progress -->
                     <div class="water-progress-wrapper my-4 position-relative d-inline-block">
                         <svg class="water-progress-ring" width="140" height="140">
                             <circle class="water-progress-ring-bg" stroke="#e9ecef" stroke-width="10" fill="transparent" r="60" cx="70" cy="70"/>
                             <circle class="water-progress-ring-bar" stroke="#0dcaf0" stroke-width="10" fill="transparent" r="60" cx="70" cy="70" stroke-dasharray="377" stroke-dashoffset="377"/>
                         </svg>
                         <div class="water-progress-text position-absolute top-50 start-50 translate-middle text-center w-100">
                             <div class="water-percent fw-bold fs-3 text-info" id="waterPercent">0%</div>
                             <div class="water-detail text-muted small" id="waterDetail"><span id="waterCurrent">@ViewBag.WaterLogged</span> / <span id="waterGoal">@ViewBag.WaterGoal</span> ml</div>
                         </div>
                     </div>

                     <!-- Completion Alert -->
                     <div id="waterCompleteAlert" class="alert alert-success py-2 px-3 rounded-pill small mb-3 d-none animate__animated animate__bounceIn">
                         🎉 Harika! Bugünkü su hedefine ulaştın!
                     </div>

                     <!-- Quick Log Buttons -->
                     <div class="d-flex justify-content-center gap-2 mt-3">
                         <button class="btn btn-outline-info btn-sm rounded-pill px-3 py-2 log-water-btn" data-amount="250">
                             <i class="bi bi-cup-straw me-1"></i> +250 ml
                         </button>
                         <button class="btn btn-outline-info btn-sm rounded-pill px-3 py-2 log-water-btn" data-amount="500">
                             <i class="bi bi-water me-1"></i> +500 ml
                         </button>
                         <button class="btn btn-outline-info btn-sm rounded-pill px-3 py-2 log-water-btn" data-amount="750">
                              <i class="bi bi-droplet-half me-1"></i> +750
                         </button>
                     </div>
                 </div>
             </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ctx = document.getElementById('mealChart').getContext('2d');
            
            // ASP.NET MVC model data -> JavaScript array
            const labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
            const data = @Html.Raw(Json.Serialize(ViewBag.ChartData));

            if(labels.length === 0) {
                // Veri yoksa göstermelik boş bir grafik (Kullanıcıya veri gir reaksiyonu vermek için)
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['7 Gün Önce', 'Bugün'],
                        datasets: [{
                            label: 'Girilen Öğün',
                            data: [0, 0],
                            backgroundColor: '#e9ecef',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: { y: { beginAtZero: true, suggestedMax: 3 } },
                        plugins: { legend: { display: false } }
                    }
                });
            }
            else {
                // Gerçek Veri (Line Chart - Kıvrımlı çizgi)
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Girilen Öğün Sayısı',
                            data: data,
                            borderColor: '#2E8B57', // Primary Color
                            backgroundColor: 'rgba(46, 139, 87, 0.2)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.4, // Smoothing
                            pointBackgroundColor: '#2E8B57',
                            pointRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0 } // Tam sayılar
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(context) { return context.parsed.y + ' Öğün Girildi'; }
                                }
                            }
                        }
                    }
                });
            }

            // --- WATER TRACKER LOGIC ---
            const waterPercentEl = document.getElementById('waterPercent');
            const waterCurrentEl = document.getElementById('waterCurrent');
            const waterGoalEl = document.getElementById('waterGoal');
            const waterCompleteAlert = document.getElementById('waterCompleteAlert');
            const newGoalInput = document.getElementById('newGoalInput');
            const progressCircle = document.querySelector('.water-progress-ring-bar');
            
            const radius = progressCircle.r.baseVal.value;
            const circumference = radius * 2 * Math.PI;
            progressCircle.style.strokeDasharray = `${circumference} ${circumference}`;

            function setProgress(percent) {
                const offset = circumference - (Math.min(percent, 100) / 100) * circumference;
                progressCircle.style.strokeDashoffset = offset;
            }

            function updateUI(current, goal) {
                waterCurrentEl.textContent = current;
                waterGoalEl.textContent = goal;
                newGoalInput.value = goal;

                const percent = goal > 0 ? Math.round((current / goal) * 100) : 0;
                waterPercentEl.textContent = percent + '%';
                setProgress(percent);

                if (percent >= 100) {
                    waterCompleteAlert.classList.remove('d-none');
                } else {
                    waterCompleteAlert.classList.add('d-none');
                }
            }

            // Initial UI update from razor values
            const initialCurrent = parseInt(waterCurrentEl.textContent) || 0;
            const initialGoal = parseInt(waterGoalEl.textContent) || 2000;
            updateUI(initialCurrent, initialGoal);

            // Log Water
            document.querySelectorAll('.log-water-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const amount = parseInt(this.getAttribute('data-amount'));
                    this.disabled = true;
                    try {
                        const response = await fetch('/Clients/LogWater', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ amountMl: amount })
                        });
                        if (response.ok) {
                            const data = await response.json();
                            updateUI(data.current, data.goal);
                        } else {
                            console.error('Su eklenirken hata oluştu:', response.statusText);
                        }
                    } catch (err) {
                        console.error('Bağlantı hatası:', err);
                    } finally {
                        this.disabled = false;
                    }
                });
            });

            // Toggle Goal Form
            const editGoalBtn = document.getElementById('editGoalBtn');
            const goalEditForm = document.getElementById('goalEditForm');
            editGoalBtn.addEventListener('click', () => {
                goalEditForm.classList.toggle('d-none');
            });

            // Save Goal
            const saveGoalBtn = document.getElementById('saveGoalBtn');
            const goalError = document.getElementById('goalError');
            saveGoalBtn.addEventListener('click', async () => {
                const newGoal = parseInt(newGoalInput.value);
                if (isNaN(newGoal) || newGoal < 500 || newGoal > 10000) {
                    goalError.textContent = "Hedef 500 ml ile 10000 ml arasında olmalıdır.";
                    goalError.classList.remove('d-none');
                    return;
                }
                goalError.classList.add('d-none');
                saveGoalBtn.disabled = true;

                try {
                    const response = await fetch('/Clients/UpdateWaterGoal', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ goalMl: newGoal })
                    });
                    if (response.ok) {
                        const data = await response.json();
                        updateUI(data.current, data.goal);
                        goalEditForm.classList.add('d-none');
                    } else {
                        goalError.textContent = "İstek başarısız oldu.";
                        goalError.classList.remove('d-none');
                    }
                } catch (err) {
                    goalError.textContent = "Bağlantı hatası.";
                    goalError.classList.remove('d-none');
                } finally {
                    saveGoalBtn.disabled = false;
                }
            });
        });
    </script>
}

<style>
.card-hover-effect {
    transition: transform 0.2s, box-shadow 0.2s;
}
.card-hover-effect:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
}
.water-tracker-card {
    background: linear-gradient(135deg, #f0f8ff 0%, #e6f7ff 100%);
    border: 1px solid rgba(13, 202, 240, 0.15) !important;
    transition: transform 0.2s, box-shadow 0.2s;
}
.dark-mode .water-tracker-card {
    background: linear-gradient(135deg, #122538 0%, #0c2b4d 100%) !important;
    border: 1px solid rgba(13, 202, 240, 0.3) !important;
}
.dark-mode .water-tracker-card h5 {
    color: #e2e8f0 !important;
}
.water-progress-ring-bar {
    transition: stroke-dashoffset 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
}
.water-tracker-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(13, 202, 240, 0.08) !important;
}
.water-progress-wrapper {
    position: relative;
    width: 140px;
    height: 140px;
}
</style>
