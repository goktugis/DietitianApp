@model IEnumerable<DietitianApp.Models.MealLog>
@{
    ViewData["Title"] = "Danışanın Öğün ve Su Takibi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="text-primary fw-bold"><i class="bi bi-journal-text me-2"></i> Danışan Takip Paneli</h2>
        <p class="text-muted fs-5 mb-0"><strong>@ViewBag.ClientName</strong> isimli danışanın beslenme ve su takip verileri.</p>
    </div>
    <a asp-controller="Dietitians" asp-action="MyClients" class="btn btn-outline-secondary rounded-pill fw-bold">
        <i class="bi bi-arrow-left me-1"></i> Danışanlarıma Dön
    </a>
</div>

<div class="row">
    <!-- Sol Taraf: Öğün Takip Tablosu -->
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm border-0 rounded-4 h-100">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-egg-fried text-primary me-2"></i> Beslenme Günlüğü</h5>
            </div>
            <div class="card-body p-4">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-file-earmark-x fs-1 d-block mb-3"></i>
                        <h5 class="fw-bold text-dark mb-0">Öğün Kaydı Yok</h5>
                        <p class="mb-0">Danışanınız henüz hiçbir öğün kaydı girmemiştir.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light text-muted small">
                                <tr>
                                    <th class="ps-3">Tarih</th>
                                    <th>Saat</th>
                                    <th>Öğün Türü</th>
                                    <th>İçerik (Ne Yedi?)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in Model)
                                {
                                    <tr>
                                        <td class="ps-3 fw-medium">@item.LogDate.ToString("dd MMM yyyy")</td>
                                        <td>@item.LogDate.ToString("HH:mm")</td>
                                        <td>
                                            <span class="badge bg-primary bg-opacity-10 text-primary py-2 px-3 rounded-pill">@item.MealType</span>
                                        </td>
                                        <td class="text-muted">@item.Description</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sağ Taraf: Su Takibi Bilgileri -->
    <div class="col-lg-4 mb-4">
        <!-- Bugünün Su Durumu -->
        <div class="card shadow-sm border-0 rounded-4 mb-4 water-tracker-card" style="background: linear-gradient(135deg, #f0f8ff 0%, #e6f7ff 100%); border: 1px solid rgba(13, 202, 240, 0.15) !important;">
            <div class="card-body p-4 text-center">
                <h5 class="fw-bold text-dark text-start mb-3"><i class="bi bi-droplet-fill text-info me-1"></i> Bugün İçilen Su</h5>
                
                <div class="my-3 position-relative d-inline-block" style="width: 120px; height: 120px;">
                     <svg width="120" height="120">
                         <circle stroke="#e9ecef" stroke-width="8" fill="transparent" r="50" cx="60" cy="60"/>
                         <circle class="water-progress-ring-bar" id="waterProgressRing" stroke="#0dcaf0" stroke-width="8" fill="transparent" r="50" cx="60" cy="60" stroke-dasharray="314" stroke-dashoffset="314"/>
                     </svg>
                     <div class="position-absolute top-50 start-50 translate-middle text-center w-100">
                         <div class="fw-bold fs-4 text-info" id="waterPercent">0%</div>
                         <div class="text-muted small" style="font-size: 0.75rem;"><span id="waterCurrent">@ViewBag.WaterLoggedToday</span> / <span id="waterGoal">@ViewBag.WaterGoal</span> ml</div>
                     </div>
                </div>
                
                <div class="mt-3">
                    @if (ViewBag.WaterLoggedToday >= ViewBag.WaterGoal)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 d-block text-wrap">
                            🎉 Danışanınız günlük su hedefine ulaştı!
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-2 d-block text-wrap" style="color: #0c63e4 !important; background-color: rgba(13, 202, 240, 0.1) !important;">
                            💧 Hedefe ulaşmak için @(ViewBag.WaterGoal - ViewBag.WaterLoggedToday) ml daha içilmeli.
                        </span>
                    }
                </div>
            </div>
        </div>

        <!-- Haftalık Su Grafiği -->
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-fill text-primary me-1"></i> Haftalık Su Takibi</h5>
            </div>
            <div class="card-body p-4">
                <canvas id="waterChart" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Circle Animation
            const current = @ViewBag.WaterLoggedToday;
            const goal = @ViewBag.WaterGoal;
            const percent = goal > 0 ? Math.min(Math.round((current / goal) * 100), 100) : 0;
            
            document.getElementById('waterPercent').textContent = percent + '%';
            
            const circle = document.getElementById('waterProgressRing');
            const radius = circle.r.baseVal.value;
            const circumference = radius * 2 * Math.PI;
            circle.style.strokeDasharray = `${circumference} ${circumference}`;
            const offset = circumference - (percent / 100) * circumference;
            circle.style.strokeDashoffset = offset;

            // Chart
            const ctx = document.getElementById('waterChart').getContext('2d');
            const labels = @Html.Raw(Json.Serialize(ViewBag.WaterLabels));
            const data = @Html.Raw(Json.Serialize(ViewBag.WaterData));

            if(labels && labels.length > 0) {
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Su Tüketimi (ml)',
                            data: data,
                            backgroundColor: 'rgba(13, 202, 240, 0.6)',
                            borderColor: '#0dcaf0',
                            borderWidth: 1.5,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                title: { display: true, text: 'ml' }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            } else {
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Kayıt Yok'],
                        datasets: [{
                            label: 'Su Tüketimi',
                            data: [0],
                            backgroundColor: '#e9ecef',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: { y: { beginAtZero: true } },
                        plugins: { legend: { display: false } }
                    }
                });
            }
        });
    </script>
}

<style>
.water-progress-ring-bar {
    transition: stroke-dashoffset 0.65s cubic-bezier(0.4, 0, 0.2, 1);
    transform: rotate(-90deg);
    transform-origin: 50% 50%;
}
.dark-mode .water-tracker-card {
    background: linear-gradient(135deg, #122538 0%, #0c2b4d 100%) !important;
    border: 1px solid rgba(13, 202, 240, 0.3) !important;
}
.dark-mode .water-tracker-card h5 {
    color: #e2e8f0 !important;
}
</style>
